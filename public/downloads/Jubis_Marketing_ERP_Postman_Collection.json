							"mode": "raw",
							"raw": "{\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Dela Cruz\",\n  \"email\": \"juan@example.com\",\n  \"company\": \"ABC Builders\",\n  \"phone\": \"09171234567\",\n  \"message\": \"Requesting formal wholesale quotation for industrial wires.\"\n}"
