{
	"info": {
		"_postman_id": "jubis-erp-collection-2026",
		"name": "Jubis Marketing ERP API Collection",
		"description": "Comprehensive Postman collection for system testing and quality assurance of Jubis Marketing ERP.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Authentication",
			"item": [
				{
					"name": "Register Client",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Test B2B Client\",\n  \"email\": \"testb2b@company.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\",\n  \"company_name\": \"Test Engineering Inc.\",\n  \"phone\": \"+639123456789\",\n  \"billing_address\": \"123 Metro Manila, PH\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/register",
							"host": ["{{base_url}}"],
							"path": ["register"]
						}
					}
				},
				{
					"name": "Login User",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@jubismarketing.com\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/login",
							"host": ["{{base_url}}"],
							"path": ["login"]
						}
					}
				},
				{
					"name": "Forgot Password",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Accept", "value": "application/json"},
							{"key": "Content-Type", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"client@engineeringcorp.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/forgot-password",
							"host": ["{{base_url}}"],
							"path": ["forgot-password"]
						}
					}
				}
			]
		},
		{
			"name": "2. Public Catalog & CRM",
			"item": [
				{
					"name": "Get Products Catalog (Paginated)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/products?search=wire&sort=name",
							"host": ["{{base_url}}"],
							"path": ["products"],
							"query": [
								{"key": "search", "value": "wire"},
								{"key": "sort", "value": "name"}
							]
						}
					}
				},
				{
					"name": "Get Product Details by ID",
					"request": {
						"method": "GET",
						"header": [
